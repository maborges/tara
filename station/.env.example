# URL do serviço independente. Se vazio, usa o router legado do AgroSaaS.
BALANCA_SERVICE_URL=http://balanca-service:8010
BALANCA_SERVICE_CLIENT_ID=client-id-da-estacao
BALANCA_SERVICE_CLIENT_SECRET=segredo-da-estacao
# Necessário para ativação inicial da estação; o token depois carrega o tenant.
BALANCA_TENANT_ID=00000000-0000-0000-0000-000000000000
