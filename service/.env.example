TARA_DATABASE_URL=postgresql+asyncpg://borgus:senha@192.168.0.3/farms
TARA_ENVIRONMENT=production
TARA_JWT_SECRET_SECRET=change-me-generate-with-openssl-rand-hex-32
TARA_JWT_ACCESS_MINUTES=30
# Somente para compatibilidade temporária; mantenha false em produção.
TARA_ALLOW_LEGACY_API_KEY=false
TARA_PUBLIC_URL=http://localhost:3005
TARA_EMAIL_TOKEN_MINUTES=30
TARA_HOST=0.0.0.0
TARA_PORT=8010
TARA_CORS_ORIGINS=["http://localhost:3004","http://127.0.0.1:3004","http://localhost:3005","http://127.0.0.1:3005"]
# Uma ou mais Contas separadas por vírgula; o worker mantém o isolamento RLS.
TARA_OUTBOX_TENANT_IDS=00000000-0000-0000-0000-000000000000
# Configure um dos destinos:
# Preferir destinos isolados por Conta:
# TARA_OUTBOX_ACCOUNT_DESTINATIONS_JSON={"<account_uuid>": {"url": "https://cliente.example/events", "hmac_secret": "troque-este-segredo"}}
# TARA_OUTBOX_TARGET_URL=https://cliente.example/events
# TARA_OUTBOX_TARGET_API_KEY=troque-esta-chave
# TARA_OUTBOX_FILE_PATH=/var/lib/balanca/outbox/events.jsonl
